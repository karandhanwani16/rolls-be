// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "mysql"
  url       = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
  profile    Profile?

  @@map("users")
}

model Profile {
  id         String   @id
  full_name  String?
  avatar_url String?
  role       String?  @default("user")
  updated_at DateTime @default(now()) @updatedAt
  user       User     @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Customer {
  id                    String              @id @default(uuid()) @map("customer_id")
  name                  String              @map("customer_name")
  phone                 String?             @map("customer_phone")
  description           String?             @map("customer_description")
  city                  String?             @map("customer_city")
  type                  String?             @map("customer_type")
  opening_balance       Float               @default(0) @map("customer_opening_balance")
  opening_balance_date  DateTime?           @map("customer_opening_balance_date")
  credit_days           Int                 @default(0) @map("customer_credit_days")
  created_at            DateTime            @default(now())
  updated_at            DateTime            @default(now()) @updatedAt
  sales                 Sale[]
  sales_returns         SaleReturn[]
  bill_to_bill_payments BillToBillPayment[]
  // Relations
  receive_payments      PaymentIn[]         @relation("ReceivePayments")
  actual_payments       PaymentIn[]         @relation("ActualPayments")
  transactions          Transaction[]

  @@map("customers")
}

model Supplier {
  id                   String        @id @default(uuid()) @map("supplier_id")
  name                 String        @map("supplier_name")
  phone                String?       @map("supplier_phone")
  description          String?       @map("supplier_description")
  city                 String?       @map("supplier_city")
  opening_balance      Float         @default(0) @map("supplier_opening_balance")
  opening_balance_date DateTime?     @map("supplier_opening_balance_date")
  created_at           DateTime      @default(now())
  updated_at           DateTime      @default(now()) @updatedAt
  payments_out     PaymentOut[]
  purchases        Purchase[]
  purchase_returns PurchaseReturn[]
  transactions     Transaction[]

  @@map("suppliers")
}

model Godown {
  id         String   @id @default(uuid()) @map("godown_id")
  name       String   @map("godown_name")
  sales      Sale[]
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map("godowns")
}

model PaymentIn {
  id              String    @id @default(cuid())
  payment_date    DateTime? @map("payment_date")
  receive_id      String?
  actual_id       String?
  received_amount Float
  actual_amount   Float
  charges         Float?
  type            String
  description     String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  // Relations
  receive_customer Customer? @relation("ReceivePayments", fields: [receive_id], references: [id])
  actual_customer  Customer? @relation("ActualPayments", fields: [actual_id], references: [id])

  @@index([receive_id])
  @@index([actual_id])
  @@map("paymentin")
}

model PaymentOut {
  id           String    @id @default(uuid()) @map("payment_out_id")
  payment_date DateTime? @map("payment_out_date")
  supplier     Supplier  @relation(fields: [supplier_id], references: [id])
  supplier_id  String
  amount       Float     @map("payment_out_amount")
  description  String?   @map("payment_out_description")
  type         String    @map("payment_out_type")
  cheque_date  DateTime? @map("payment_out_cheque_date")
  created_at   DateTime  @default(now())
  updated_at   DateTime  @default(now()) @updatedAt

  @@map("payments_out")
}

model Purchase {
  id            String         @id @default(uuid()) @map("purchase_id")
  supplier      Supplier       @relation(fields: [supplier_id], references: [id])
  supplier_id   String
  supplier_name String         @map("supplier_name")
  date          DateTime       @map("purchase_date")
  total         Float          @map("purchase_total")
  purchase_no   String         @map("purchase_no")
  description   String?        @map("purchase_description")
  godown        String?        @map("purchase_godown")
  transport           String?        @map("purchase_transport")
  transport_charges   Float?         @default(0) @map("purchase_transport_charges")
  discount            Float?         @default(0) @map("purchase_discount")
  unit                String         @default("m") @map("purchase_unit")
  received_by         String?        @map("purchase_received_by")
  created_at    DateTime       @default(now())
  updated_at    DateTime       @default(now()) @updatedAt
  items         PurchaseItem[]
  purchase_returns PurchaseReturn[]

  @@map("purchases")
}

enum PurchaseItemStatus {
  UNSOLD
  SOLD
  RETURNED
}

model PurchaseItem {
  id           String             @id @default(uuid()) @map("purchase_items_id")
  purchase     Purchase           @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
  purchase_id  String
  product_id   String?            @map("product_id")
  product_name String             @map("product_name")
  roll_no      String?            @map("purchase_items_roll_no")
  shade        String?            @map("purchase_items_shade")
  meters       Float              @map("purchase_items_meters")
  unit         String             @default("m") @map("purchase_items_unit")
  price        Float              @map("purchase_items_price")
  total        Float              @map("purchase_items_total")
  status       PurchaseItemStatus @map("purchase_items_status")
  created_at   DateTime           @default(now())
  updated_at   DateTime           @default(now()) @updatedAt

  @@map("purchase_items")
}

model Sale {
  id            String                    @id @default(uuid()) @map("sales_id")
  date          DateTime                  @map("sales_date")
  sales_no      String                    @map("sales_no")
  customer      Customer                  @relation(fields: [customer_id], references: [id])
  godown        Godown?                   @relation(fields: [godown_id], references: [id])
  godown_id     String?                   @map("sales_godown_id")
  customer_id   String                    @map("customer_id")
  customer_name String                    @map("customer_name")
  total         Float                     @map("sales_total")
  description   String?                   @map("sales_description")
  hamaal        String?                   @map("sales_hamaal")
  challan_no    String?                   @map("sales_challan_no")
  maker              String?                   @map("sales_maker")
  sales_by           String?                   @map("sales_by")
  transport_charges  Float?                    @default(0) @map("sales_transport_charges")
  discount           Float?                    @default(0) @map("sales_discount")
  credit_days        Int                       @default(0) @map("sales_credit_days")
  unit               String                    @default("m") @map("sales_unit")
  created_at    DateTime                  @default(now())
  updated_at    DateTime                  @default(now()) @updatedAt
  items         SaleItem[]
  bill_payments BillToBillPaymentDetail[]
  sale_returns  SaleReturn[]

  @@map("sales")
}

model SaleItem {
  id               String   @id @default(uuid()) @map("sales_items_id")
  sale             Sale     @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  sale_id          String   @map("sales_id")
  product_id       String?  @map("product_id")
  product_name     String   @map("product_name")
  purchase_item_id String?  @map("purchase_item_id")
  roll_no          String?  @map("sales_items_roll_no")
  shade            String?  @map("sales_items_shade")
  meters           Float    @map("sales_items_meters")
  unit             String   @default("m") @map("sales_items_unit")
  price            Float    @map("sales_items_price")
  total            Float    @map("sales_items_total")
  created_at       DateTime @default(now())
  updated_at       DateTime @default(now()) @updatedAt

  @@map("sales_items")
}

model SaleReturn {
  id                 String           @id @default(uuid()) @map("sales_return_id")
  date               DateTime         @map("sales_return_date")
  return_no          String           @map("sales_return_no")
  customer           Customer         @relation(fields: [customer_id], references: [id])
  customer_id        String           @map("customer_id")
  customer_name      String           @map("customer_name")
  sale               Sale?            @relation(fields: [sale_id], references: [id])
  sale_id            String?          @map("sales_return_sale_id")
  total              Float            @map("sales_return_total")
  description        String?          @map("sales_return_description")
  transport_charges  Float?           @default(0) @map("sales_return_transport_charges")
  created_at         DateTime         @default(now())
  updated_at         DateTime         @default(now()) @updatedAt
  items              SaleReturnItem[]

  @@map("sales_returns")
}

model SaleReturnItem {
  id               String     @id @default(uuid()) @map("sales_return_items_id")
  sale_return      SaleReturn @relation(fields: [sale_return_id], references: [id], onDelete: Cascade)
  sale_return_id   String     @map("sales_return_id")
  product_id       String?    @map("product_id")
  product_name     String     @map("product_name")
  purchase_item_id String?    @map("purchase_item_id")
  roll_no          String?    @map("sales_return_items_roll_no")
  meters           Float      @map("sales_return_items_meters")
  unit             String     @default("m") @map("sales_return_items_unit")
  price            Float      @map("sales_return_items_price")
  total            Float      @map("sales_return_items_total")
  created_at       DateTime   @default(now())
  updated_at       DateTime   @default(now()) @updatedAt

  @@map("sales_return_items")
}

model PurchaseReturn {
  id                 String               @id @default(uuid()) @map("purchase_return_id")
  date               DateTime             @map("purchase_return_date")
  return_no          String               @map("purchase_return_no")
  supplier           Supplier             @relation(fields: [supplier_id], references: [id])
  supplier_id        String
  supplier_name      String               @map("supplier_name")
  purchase           Purchase?            @relation(fields: [purchase_id], references: [id])
  purchase_id        String?              @map("purchase_return_purchase_id")
  total              Float                @map("purchase_return_total")
  description        String?              @map("purchase_return_description")
  transport_charges  Float?               @default(0) @map("purchase_return_transport_charges")
  created_at         DateTime             @default(now())
  updated_at         DateTime             @default(now()) @updatedAt
  items              PurchaseReturnItem[]

  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id                 String         @id @default(uuid()) @map("purchase_return_items_id")
  purchase_return    PurchaseReturn @relation(fields: [purchase_return_id], references: [id], onDelete: Cascade)
  purchase_return_id String         @map("purchase_return_id")
  product_id         String?        @map("product_id")
  product_name       String         @map("product_name")
  purchase_item_id   String?        @map("purchase_item_id")
  roll_no            String?        @map("purchase_return_items_roll_no")
  meters             Float          @map("purchase_return_items_meters")
  unit               String         @default("m") @map("purchase_return_items_unit")
  price              Float          @map("purchase_return_items_price")
  total              Float          @map("purchase_return_items_total")
  created_at         DateTime       @default(now())
  updated_at         DateTime       @default(now()) @updatedAt

  @@map("purchase_return_items")
}

model BillToBillPayment {
  id                     String                    @id @default(uuid()) @map("bill_to_bill_payment_id")
  customer               Customer                  @relation(fields: [customer_id], references: [id])
  customer_id            String                    @map("customer_id")
  bill_clear_date        DateTime                  @map("bill_clear_date")
  bill_overflow_amount   Float                     @default(0) @map("bill_overflow_amount")
  bill_latest_clear_date DateTime                  @map("bill_latest_clear_date")
  created_at             DateTime                  @default(now())
  updated_at             DateTime                  @default(now()) @updatedAt
  details                BillToBillPaymentDetail[]
  settlements            BillSettlement[]

  @@map("bill_to_bill_payments")
}

model BillToBillPaymentDetail {
  id              String            @id @default(uuid()) @map("bill_detail_id")
  bill_payment    BillToBillPayment @relation(fields: [bill_payment_id], references: [id], onDelete: Cascade)
  bill_payment_id String            @map("bill_payment_id")
  sale            Sale              @relation(fields: [sale_id], references: [id])
  sale_id         String            @map("sale_id")
  cleared_amount  Float             @map("cleared_amount")
  status          String            @map("payment_status") // "FULL", "PARTIAL"
  created_at      DateTime          @default(now())
  updated_at      DateTime          @default(now()) @updatedAt

  @@map("bill_to_bill_payment_details")
}

model BillSettlement {
  id              String            @id @default(uuid()) @map("settlement_id")
  bill_payment    BillToBillPayment @relation(fields: [bill_payment_id], references: [id], onDelete: Cascade)
  bill_payment_id String            @map("bill_payment_id")
  settlement_date DateTime          @map("settlement_date")
  total_amount    Float             @map("total_amount")
  overflow_amount Float             @default(0) @map("overflow_amount")
  description     String?           @map("settlement_description")
  created_at      DateTime          @default(now())
  updated_at      DateTime          @default(now()) @updatedAt

  @@map("bill_settlements")
}

model Product {
  id          String   @id @default(uuid()) @map("product_id")
  name        String   @map("product_name")
  description String?  @map("product_description")
  price       Float    @map("product_price")
  color       String?  @map("product_color")
  width       String?  @map("product_width")
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  @@map("products")
}

model Transaction {
  id          String    @id @default(uuid()) @map("transaction_id")
  type        String    @map("transaction_type")
  description String?   @map("transaction_description")
  customer_id String?   @map("transaction_customer_id")
  supplier_id String?   @map("transaction_supplier_id")
  amount      Float     @map("transaction_amount")
  created_at  DateTime  @default(now())
  updated_at  DateTime  @default(now()) @updatedAt
  customer    Customer? @relation(fields: [customer_id], references: [id])
  supplier    Supplier? @relation(fields: [supplier_id], references: [id])

  @@map("transactions")
}
