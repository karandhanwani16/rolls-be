
# Database
DATABASE_URL="postgresql://username:password@localhost:5432/mohit_traders?schema=public"

# JWT Secret - Change this to a secure random string
JWT_SECRET="your-very-secure-jwt-secret-key-here"

# Server port
PORT=3001

# Comma-separated list of allowed frontend origins
CORS_ORIGINS="http://localhost:8080,http://mohittraders.local,https://hoppscotch.io"

# Additional settings
NODE_ENV="development"
