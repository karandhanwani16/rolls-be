# SQLite on the local USB_ROOT (development uses <repo>/usb-dev, not a physical drive).
USB_ROOT="usb-dev"
DATABASE_PATH="usb-dev/data/database.sqlite"
# Relative to prisma/schema.prisma (for Prisma CLI). Runtime uses DATABASE_PATH.
DATABASE_URL="file:../../usb-dev/data/database.sqlite"

# JWT Secret - Change this to a secure random string
JWT_SECRET="your-very-secure-jwt-secret-key-here"

# Server port
PORT=3001

# Comma-separated list of allowed frontend origins
CORS_ORIGINS="http://localhost:8080,http://mohittraders.local,https://hoppscotch.io"

# Additional settings
NODE_ENV="development"
