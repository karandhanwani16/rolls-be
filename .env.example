# --- Cloud demo (Render + Aiven MySQL) ---
# Leave USB_ROOT / DATABASE_PATH unset. Prisma schema provider must be "mysql".
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/defaultdb?ssl-mode=REQUIRED"

# --- USB / Electron (SQLite) — after demo ---
# Switch schema.prisma provider to "sqlite", then use:
# USB_ROOT="usb-dev"
# DATABASE_PATH="usb-dev/data/database.sqlite"
# DATABASE_URL="file:../../usb-dev/data/database.sqlite"

# JWT Secret - Change this to a secure random string
JWT_SECRET="your-very-secure-jwt-secret-key-here"

# Server port (Render sets PORT automatically)
PORT=3001

# Include your Vercel demo origin(s)
CORS_ORIGINS="http://localhost:8080,https://YOUR-APP.vercel.app"

NODE_ENV="development"
